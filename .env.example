# MediaFlow Environment Configuration
# Copy this file to .env and fill in the values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./mediaflow.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mediaflow

# Redis (optional for dev, required for production)
# REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
# S3_BUCKET=mediaflow-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Media Processing
MAX_FILE_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=5
MAX_CONCURRENT_CONVERSIONS=3
DOWNLOAD_TIMEOUT_SECONDS=3600
CONVERSION_TIMEOUT_SECONDS=7200
FILE_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_DOWNLOAD=10/minute
RATE_LIMIT_CONVERT=5/minute

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MediaFlow
